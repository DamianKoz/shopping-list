[Unit]
Description=Einkaufsliste
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/shopping-list
EnvironmentFile=/home/deploy/shopping-list/env
ExecStart=/home/deploy/shopping-list/shopping-list
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/shopping-list

[Install]
WantedBy=multi-user.target
